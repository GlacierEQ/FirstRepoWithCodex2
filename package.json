{
  "name": "mytasks2do_backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend API for MyTasks2Do",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "closeServer": "node src/scripts/closeServer.js",
    "seed": "node prisma/seed.js",
    "test-positive": "newman run \"./postman/collections/MyTasks2Do API.json\" -e \"./postman/environments/Local.postman_environment.json\"",
    "test-negative": "newman run \"./postman/collections/MyTasks2Do API Negative.json\" -e \"./postman/environments/Local.postman_environment.json\"",
    "test": "npm run test-positive && npm run test-negative"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@sentry/node": "^9.3.0",
    "@sentry/profiling-node": "^7.120.2",
    "@sentry/tracing": "^7.120.2",
    "axios": "^1.7.7",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-oauth2-jwt-bearer": "^1.6.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "jwt-decode": "^4.0.0",
    "uuid": "^10.0.0",
    "winston": "^3.15.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "newman": "^6.2.0",
    "nodemon": "^3.1.9",
    "prisma": "^6.13.0"
  },
  "prisma": {
    "seed": "node ./prisma/seed.js"
  }
}
